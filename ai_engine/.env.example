# Copier en ai_engine/.env puis renseigner.
# Sans ces valeurs, le bouton « Envoyer un email de test » répond
# explicitement « SMTP non configuré » au lieu de simuler un succès.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cv-gateway@elastic-solutions.tn
